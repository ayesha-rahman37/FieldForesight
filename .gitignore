# ==============================================================================
# FieldForesight Root .gitignore
# ==============================================================================

# ===== Python & Bytecode =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ===== Virtual Environments =====
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# ===== Environment Variables & Secrets =====
.env
.env.*
*.env
frontend/.env
frontend/.env.*
!.env.example
!frontend/.env.example

# Secret Keys, SSL Certificates & Service Account Credentials
*.pem
*.key
*.cert
*.crt
credentials.json
client_secret*.json
service-account*.json
secrets.json

# ===== Tests, Coverage & QA =====
tests/
test/
*_test.py
test_*.py
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# ===== ML Models, Weights & Serialized Data =====
*.h5
*.joblib
*.pkl
*.pt
*.pth
*.onnx

# ===== Vector Databases & Local Stores =====
app/data/chroma/
chroma/
*.sqlite
*.sqlite3
*.db
field_foresight.db
*.dump
*.sql

# ===== Cache & Build Artifacts =====
*.egg-info/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
satellite_output/

# ===== Node.js / React Frontend =====
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache

# ===== IDEs, OS & Tooling =====
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ===== Logs & Temporary Files =====
*.log
logs/
scratch/
.gemini/
