# Backend API URL (defaults to http://localhost:8000 if omitted)
VITE_API_URL=http://localhost:8000

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
# e.g., 1234567890-abcdefg123456.apps.googleusercontent.com
# If left empty, the UI uses the interactive 1-click & custom email OAuth fallback for development.
VITE_GOOGLE_CLIENT_ID=

