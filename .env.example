# Groq LLM configuration (required for chatbot)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHATBOT_MAX_TOKENS=3000

# Database and frontend
DATABASE_URL=sqlite:///./field_foresight.db
FRONTEND_ORIGIN=http://localhost:5173

# Optional Sentinel Hub / Copernicus Data Space credentials
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# Optional Neo4j knowledge graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_THIS_TO_A_UNIQUE_PASSWORD

# Protect the MCP endpoint. Set a long, random value; do not use a public default.
MCP_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Optional RAG tuning
# RAG_CHROMA_DIR=app/data/chroma
# RAG_COLLECTION_NAME=knowledge
# RAG_SIMILARITY_THRESHOLD=0.05
# RAG_DEFAULT_TOP_K=4
