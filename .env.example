# Groq LLM Configuration (for Bangla Agricultural Advisory & Explainability)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Sentinel Hub (Copernicus Data Space Ecosystem) for live satellite refresh
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# Database & CORS
DATABASE_URL=sqlite:///./field_foresight.db
FRONTEND_ORIGIN=http://localhost:5173

